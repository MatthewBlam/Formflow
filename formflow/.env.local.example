OPENAI_API_KEY=your_openai_api_key_here
# Optional: override the default extraction model.
# OPENAI_EXTRACT_MODEL=gpt-4.1-mini
# Optional: cap page-by-page vision extraction for demos and low RPM limits.
# The extractor batches these pages into one OpenAI request. Use 1 for the safest demo.
# FORMFLOW_MAX_VISION_PAGES=3
